# ── Triton 볼륨 마운트 경로 ──
MODEL_REPO_PATH=/home/inu0608/hdd/capston/triton/model_repository
MODEL_PATH=/home/inu0608/hdd/capston/models

# ── 모델 설정 ──
# MODEL_PATH: 로컬 모델 디렉토리 (예: /models/gemma-4-E4B-it)
# MODEL_ID:   로컬 경로 없을 때 fallback HuggingFace ID
MODEL_ID=google/gemma-4-E4B-it
DEVICE_MAP=cuda:0          # cuda:0 / cpu

# ── 요청 설정 ──
REQUEST_TIMEOUT=120        # 추론 타임아웃 (초)
MAX_AUDIO_SIZE_MB=50       # 음성 파일 최대 크기 (MB)
