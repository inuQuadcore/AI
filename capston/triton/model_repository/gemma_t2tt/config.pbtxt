name: "gemma_t2tt"
backend: "python"
max_batch_size: 0

parameters: {
  key: "EXECUTION_ENV_PATH"
  value: { string_value: "/models/triton_envs/gemma_triton_py312.tar.gz" }
}

input [
  {
    name: "TEXT"
    data_type: TYPE_STRING
    dims: [ 1 ]
  },
  {
    name: "SOURCE_LANGUAGE"
    data_type: TYPE_STRING
    dims: [ 1 ]
  },
  {
    name: "TARGET_LANGUAGE"
    data_type: TYPE_STRING
    dims: [ 1 ]
  }
]

output [
  {
    name: "SOURCE_TEXT"
    data_type: TYPE_STRING
    dims: [ 1 ]
  },
  {
    name: "SOURCE_LANGUAGE"
    data_type: TYPE_STRING
    dims: [ 1 ]
  },
  {
    name: "TRANSLATED_TEXT"
    data_type: TYPE_STRING
    dims: [ 1 ]
  },
  {
    name: "TARGET_LANGUAGE"
    data_type: TYPE_STRING
    dims: [ 1 ]
  },
  {
    name: "RAW_RESPONSE"
    data_type: TYPE_STRING
    dims: [ 1 ]
  },
  {
    name: "INFERENCE_SECONDS"
    data_type: TYPE_FP32
    dims: [ 1 ]
  }
]

instance_group [
  {
    kind: KIND_GPU
    count: 1
  }
]
