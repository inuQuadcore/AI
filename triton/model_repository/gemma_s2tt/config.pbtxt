name: "gemma_s2tt"
backend: "python"
max_batch_size: 0

# EXECUTION_ENV_PATH 제거 — 패키지는 커스텀 Docker 이미지(triton/Dockerfile)에 포함
input [
  {
    name: "AUDIO_BYTES"
    data_type: TYPE_STRING
    dims: [ 1 ]
  },
  {
    name: "TARGET_LANGUAGE"
    data_type: TYPE_STRING
    dims: [ 1 ]
  }
]

output [
  {
    name: "SOURCE_TEXT"
    data_type: TYPE_STRING
    dims: [ 1 ]
  },
  {
    name: "SOURCE_LANGUAGE"
    data_type: TYPE_STRING
    dims: [ 1 ]
  },
  {
    name: "TRANSLATED_TEXT"
    data_type: TYPE_STRING
    dims: [ 1 ]
  },
  {
    name: "TARGET_LANGUAGE"
    data_type: TYPE_STRING
    dims: [ 1 ]
  },
  {
    name: "RAW_RESPONSE"
    data_type: TYPE_STRING
    dims: [ 1 ]
  },
  {
    name: "INFERENCE_SECONDS"
    data_type: TYPE_FP32
    dims: [ 1 ]
  }
]

instance_group [
  {
    kind: KIND_GPU
    count: 1
    gpus: [0]
  },
  {
    kind: KIND_GPU
    count: 1
    gpus: [1]
  }
]
